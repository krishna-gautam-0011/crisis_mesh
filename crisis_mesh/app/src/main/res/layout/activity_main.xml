<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Homepage artwork - see BrandingConfig.kt / res/drawable/homepage_image.xml to replace -->
    <ImageView
        android:id="@+id/homepageImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Scrim so button text stays legible over any image -->
    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/homepage_bottom_scrim" />

    <!-- Only the two entry buttons, pinned to the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterMeshButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Enter Mesh"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_chat_logo"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:cornerRadius="27dp"
            app:backgroundTint="@color/brand_solid" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enterMapsButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Enter Maps"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_map"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:cornerRadius="27dp"
            app:backgroundTint="@color/location_accent" />

    </LinearLayout>

</FrameLayout>
